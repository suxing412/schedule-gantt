[
  {
    "name": "project.update",
    "description": "修改共享排期标题；视图、列宽和折叠属于个人界面状态，不写入共享数据。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "patch": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "patch"
      ],
      "additionalProperties": false
    },
    "destructiveHint": false
  },
  {
    "name": "project.replace",
    "description": "用完整 JSON 导入或恢复排期，替换全部共享内容；须显式传 confirm:true。不会更改排期链接、权限或版本规则。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": true
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "project",
        "confirm"
      ],
      "additionalProperties": false
    },
    "destructiveHint": true
  },
  {
    "name": "project.shift",
    "description": "按自然日平移整个排期的全部任务和全局里程碑；正数后移、负数前移。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "minimum": -36500,
          "maximum": 36500
        }
      },
      "required": [
        "days"
      ],
      "additionalProperties": false
    },
    "destructiveHint": false
  },
  {
    "name": "task.add",
    "description": "添加任务、子任务、管线或重要节点。ID 由调用者指定；pid 指向父任务；beforeId 可指定同层插入位置，省略追加。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            "pid": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256,
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            },
            "type": {
              "enum": [
                "task",
                "milestone",
                "pipeline"
              ]
            },
            "s": {
              "type": "string",
              "maxLength": 10,
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "e": {
              "type": "string",
              "maxLength": 10,
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "who": {
              "type": "string",
              "maxLength": 512
            },
            "grp": {
              "type": "string",
              "maxLength": 256
            },
            "phase": {
              "type": "string",
              "maxLength": 512
            },
            "flow": {
              "type": "boolean"
            },
            "lane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "customValues": {
              "type": "object",
              "propertyNames": {
                "pattern": "^cf_[A-Za-z0-9_-]{1,64}$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "deps": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1
              },
              "maxItems": 10000,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "name",
            "s",
            "e"
          ],
          "additionalProperties": false
        },
        "beforeId": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": [
        "task"
      ],
      "additionalProperties": false
    },
    "destructiveHint": false
  },
