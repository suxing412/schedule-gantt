# Local development only. npm start uses the current process environment.
# Optional: node --env-file=.env server.js (Node.js 22+).
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
STORAGE_DRIVER=file
DATA_DIR=.data

# Production requires a real external database adapter and a private random secret.
# NODE_ENV=production
# STORAGE_DRIVER=external
# STORAGE_ADAPTER_MODULE=/absolute/path/to/your-cloud-adapter.cjs
# SESSION_SECRET=<generate-at-least-32-random-bytes-and-keep-private>
# PUBLIC_ORIGIN=https://your-published-domain.example
